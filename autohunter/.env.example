# ============ AutoHunter — переменные окружения ============
# Скопируйте в .env:  cp .env.example .env  и заполните. Файл .env не коммитится.

# development | production. В production запрещены пароли/секреты по умолчанию.
APP_ENV=development
LOG_LEVEL=INFO

# --- Доступ к веб-панели (ОБЯЗАТЕЛЬНО поменять) ---
AUTH_PASSWORD=change-me
# случайная строка ≥16 символов, например: python -c "import secrets;print(secrets.token_urlsafe(32))"
AUTH_SECRET=change-me-too
AUTH_TOKEN_TTL_HOURS=168
API_RATE_LIMIT_PER_MINUTE=300

# --- PostgreSQL (docker compose) ---
POSTGRES_PASSWORD=autohunter
# Для запуска без Docker можно SQLite (значение по умолчанию):
# DATABASE_URL=sqlite+aiosqlite:///./autohunter.db
APP_PORT=8000

# --- Источники (через запятую): demo, apiad_avito, apiad_drom, autoru ---
# Без ключей оставьте demo — система покажет синтетические объявления.
SOURCES_ENABLED=demo
POLL_INTERVAL_SECONDS=20
POLL_JITTER_SECONDS=2
REQUEST_TIMEOUT_SECONDS=15
MAX_BACKOFF_SECONDS=300

# Демо-источник
DEMO_SEED=42
DEMO_INITIAL_LISTINGS=450
DEMO_LIVE=true

# ApiAd (https://apiad.ru) — Авито и Дром через сервис-агрегатор. Ключ — в личном кабинете apiad.ru.
# Тарифы и лимиты в открытой документации не указаны — уточните у сервиса ДО включения.
APIAD_API_KEY=
APIAD_BASE_URL=https://apiad.ru
APIAD_QUERIES=BMW,Mercedes-Benz,Audi
APIAD_MIN_INTERVAL_SECONDS=2
# Сколько новых объявлений за опрос дообогащать через parse_sync (может тарифицироваться).
# (значение по умолчанию 5 задано в коде адаптера)

# Авто.ру — публичного API поиска нет; адаптер не активируется.
AUTORU_API_KEY=

# --- Telegram ---
# Токен бота от @BotFather. Без токена уведомления пишутся в лог (режим-заглушка).
TELEGRAM_BOT_TOKEN=
# Как привязать чат: отправьте боту  /start <код>  (код = значение ниже) — или укажите id чатов явно.
TELEGRAM_PAIRING_CODE=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Оценка / уведомления ---
DISPLAY_TIMEZONE=Europe/Moscow
NOTIFY_MAX_AGE_HOURS=12
REPRICE_NOTIFY_PCT=5
LISTING_TTL_HOURS=72
REVALUATION_INTERVAL_MINUTES=30
